{
  "name": "fuzzley-frontend",
  "version": "0.2.0",
  "description": "Andrey Gavel portfolio frontend.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/fetch-games.mjs --optional && astro dev",
    "start": "yarn dev",
    "build": "node tools/fetch-games.mjs && astro build && node tools/inject-analytics.mjs",
    "games": "node tools/fetch-games.mjs",
    "preview": "astro preview",
    "force-stop": "node tools/stop-dev-servers.mjs",
    "stop": "astro dev stop",
    "check": "astro check",
    "lint": "eslint .",
    "prettier": "prettier . --write",
    "verify": "astro check && eslint . && prettier . --check && yarn build"
  },
  "author": "Andrey Gavel",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/sitemap": "^3.7.4",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "astro": "7.4.7",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "tar": "^7.5.22",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "packageManager": "yarn@4.18.1"
}
