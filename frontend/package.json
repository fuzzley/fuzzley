{
  "name": "fuzzley-frontend",
  "version": "0.2.0",
  "description": "Andrey Gavel portfolio frontend.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node tools/inject-analytics.mjs",
    "preview": "astro preview",
    "force-stop": "node tools/stop-dev-servers.mjs",
    "stop": "astro dev stop",
    "check": "astro check",
    "lint": "eslint .",
    "prettier": "prettier . --write",
    "verify": "astro check && eslint . && prettier . --check && yarn build"
  },
  "author": "Andrey Gavel",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/sitemap": "^3.7.4",
    "@emnapi/core": "^1.7.1",
    "@emnapi/runtime": "^1.7.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "astro": "7.3.8",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "packageManager": "yarn@4.17.1"
