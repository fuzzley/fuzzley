---
// The games used to live at /project/<slug>/. Hosts that can send real 301s
// (nginx) never serve these pages; GitHub Pages can't, so it serves this one,
// which forwards to the new address and keeps any #hash, which the solitaire
// game uses to pick a game.
import { getProjects } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { title: project.data.title },
  }));
}

const { title } = Astro.props;
const target = `/projects/${Astro.params.slug}/play/`;
const canonical = new URL(target, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title} has moved</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search + location.hash);
    </script>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>
      {title} has moved to <a href={target}>{canonical}</a>.
    </p>
  </body>
</html>
