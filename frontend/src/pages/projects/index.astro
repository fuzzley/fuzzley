---
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";
import GitHubLink from "../../components/GitHubLink.astro";
import { linkName, newTab } from "../../lib/links";
import {
  coverTransition,
  getProjects,
  playPath,
  projectPath,
  projectYears,
} from "../../lib/projects";

const projects = (await getProjects()).sort(
  (a, b) => b.data.started - a.data.started || a.data.order - b.data.order,
);
---

<Base
  title="Projects | Andrey Gavel"
  description="Browser games by Andrey Gavel: Solitaire Collection, Spider Solitaire, Minesweeper and Pong, and Fuzzley Games, the site where the newest are played."
>
  <header class="intro">
    <h1>Projects</h1>
    <p>
      Games I've built on the side, plus Fuzzley Games, my own game site,
      hosting the newer games I've developed.
    </p>
  </header>

  <ul class="cards" role="list">
    {projects.map((project) => (
      <li class="tile card">
        <div class="card-media" style={`--tint: ${project.data.tint}`}>
          <Picture
            src={project.data.cover}
            alt=""
            widths={[400, 640, 800]}
            sizes="(min-width: 56rem) 24rem, calc(100vw - 32px)"
            formats={["avif"]}
            fallbackFormat="webp"
            style={coverTransition(project)}
          />
        </div>
        <p class="tile-label">{projectYears(project)}</p>
        <h2>
          <a class="stretched" href={projectPath(project)}>
            {project.data.title}
          </a>
        </h2>
        <p class="card-summary">{project.data.summary}</p>
        <div class="card-actions above">
          <a
            class="button button--primary"
            href={playPath(project)}
            {...newTab(playPath(project))}
            aria-label={linkName(
              `${project.data.playLabel}: ${project.data.title}`,
              playPath(project),
            )}
          >
            {project.data.playLabel}
          </a>
          <GitHubLink
            href={project.data.repo}
            projectTitle={project.data.title}
          />
        </div>
      </li>
    ))}
  </ul>
</Base>

<style>
  .intro {
    display: grid;
    gap: 10px;
    padding-block: 12px 24px;
  }

  .intro h1 {
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .intro p {
    max-width: 52ch;
    color: var(--muted);
    font-size: var(--step-1);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--gap);
  }

  .card {
    padding-top: 0;
  }

  .card-media {
    margin-inline: calc(var(--pad) * -1);
    margin-bottom: 8px;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--tint);
  }

  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }

  .card h2 {
    font-size: var(--step-2);
  }

  .card-summary {
    color: var(--muted);
  }

  /* Play and GitHub, at the bottom of the card whatever its summary length. */
  .card-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
  }
</style>
