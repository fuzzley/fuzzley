---
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";
import {
  coverTransition,
  getProjects,
  playPath,
  projectPath,
  projectYears,
} from "../../lib/projects";

const projects = await getProjects();
---

<Base
  title="Projects | Andrey Gavel"
  description="Browser games and prototypes by Andrey Gavel: Solitaire Collection, Spider Solitaire, Minesweeper, Pong and PATH."
>
  <header class="intro">
    <h1>Projects</h1>
    <p>
      Games and prototypes I've built in my own time. Every one runs in the
      browser, and the source for each is on GitHub.
    </p>
  </header>

  <ul class="cards" role="list">
    {projects.map((project) => (
      <li class="tile card">
        <div class="card-media" style={`--tint: ${project.data.tint}`}>
          <Picture
            src={project.data.cover}
            alt=""
            widths={[400, 640, 800]}
            sizes="(min-width: 56rem) 24rem, calc(100vw - 32px)"
            formats={["avif"]}
            fallbackFormat="webp"
            style={coverTransition(project)}
          />
        </div>
        <p class="tile-label">{projectYears(project)}</p>
        <h2>
          <a class="stretched" href={projectPath(project)}>
            {project.data.title}
          </a>
        </h2>
        <p class="card-summary">{project.data.summary}</p>
        <a
          class="button button--primary above card-play"
          href={playPath(project)}
          aria-label={`${project.data.playLabel}: ${project.data.title}`}
        >
          {project.data.playLabel}
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .intro {
    display: grid;
    gap: 10px;
    padding-block: 12px 24px;
  }

  .intro h1 {
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .intro p {
    max-width: 52ch;
    color: var(--muted);
    font-size: var(--step-1);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--gap);
  }

  .card {
    padding-top: 0;
  }

  .card-media {
    margin-inline: calc(var(--pad) * -1);
    margin-bottom: 8px;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--tint);
  }

  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }

  .card h2 {
    font-size: var(--step-2);
  }

  .card-summary {
    color: var(--muted);
  }

  .card-play {
    align-self: flex-start;
    margin-top: auto;
  }
</style>
