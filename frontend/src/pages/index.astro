---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import GameTile from "../components/GameTile.astro";
import GitHubLink from "../components/GitHubLink.astro";
import me from "../assets/profile/me.jpg";
import { education, links, profile } from "../data/profile";
import { linkName, newTab } from "../lib/links";
import {
  coverTransition,
  getProjects,
  playPath,
  playShort,
  projectPath,
} from "../lib/projects";
import {
  focusAreas,
  getJobs,
  isPlaceholder,
  visibleHighlights,
  yearRange,
} from "../lib/experience";

const projects = await getProjects();
const feature = projects[0];
const featurePlay = playPath(feature);
// The games in the grid's four slots, in slot order (see `homeSlot`).
const games = projects
  .filter((project) => project.data.homeSlot !== undefined)
  .sort((a, b) => (a.data.homeSlot ?? 0) - (b.data.homeSlot ?? 0));
const jobs = await getJobs();
const current = jobs.find((job) => !job.data.end) ?? jobs[0];
const outcomes = visibleHighlights(current);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: Astro.site?.href,
  jobTitle: current.data.role,
  worksFor: { "@type": "Organization", name: current.data.org },
  alumniOf: { "@type": "CollegeOrUniversity", name: education.school },
  sameAs: links.map((link) => link.href),
};
---

<Base
  title="Andrey Gavel | Software engineer and manager"
  description="Andrey Gavel is a staff software engineer and manager at Google. Play his browser games, from the Solitaire Collection and Minesweeper on Fuzzley Games to Spider Solitaire and Pong."
  ogType="profile"
  jsonLd={jsonLd}
>
  <div class="bento home">
    <section class="tile hero" id="about" aria-labelledby="hero-name">
      <div class="hero-id">
        <Picture
          src={me}
          alt="Portrait of Andrey Gavel"
          class="hero-photo"
          widths={[80, 160]}
          sizes="80px"
          formats={["avif"]}
          fallbackFormat="webp"
        />
        <h1 id="hero-name">{profile.name}</h1>
      </div>
      <p class="hero-lede">
        {profile.lede.split(/(?<=\.)\s+/).map((sentence) => (
          <span>{sentence}</span>
        ))}
      </p>
    </section>

    <section
      class="tile tile--accent contact"
      id="contact"
      aria-labelledby="contact-title"
    >
      <h2 class="tile-label" id="contact-title">
        Say hello
      </h2>
      <a class="contact-email" href={`mailto:${profile.email}`}>
        {profile.email}
      </a>
      <ul class="link-row" role="list">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              {...newTab(link.href)}
              aria-label={linkName(link.label, link.href)}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section
      class="tile tile--media feature"
      id="projects"
      style={`--tint: ${feature.data.tint}`}
      aria-labelledby="feature-title"
    >
      <Picture
        src={feature.data.cover}
        alt={feature.data.coverAlt}
        pictureAttributes={{ class: "tile-media" }}
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 56rem) 37rem, calc(100vw - 32px)"
        formats={["avif"]}
        fallbackFormat="webp"
        style={coverTransition(feature)}
        loading="eager"
      />
      <div class="feature-card">
        <div>
          <h2 id="feature-title">
            <a class="stretched" href={projectPath(feature)}>
              {feature.data.title}
            </a>
          </h2>
          <p class="feature-tagline">{feature.data.tagline}</p>
        </div>
        <div class="feature-actions above">
          <a
            class="button button--primary"
            href={featurePlay}
            {...newTab(featurePlay)}
            aria-label={linkName(
              `${playShort(feature)} ${feature.data.title}`,
              featurePlay,
            )}
          >
            {playShort(feature)}
          </a>
          <GitHubLink
            href={feature.data.repo}
            projectTitle={feature.data.title}
          />
        </div>
      </div>
    </section>

    <section class="tile tile--strong now" aria-labelledby="now-title">
      <div class="now-group">
        <p class="tile-label">Now</p>
        <h2 id="now-title">{current.data.org}</h2>
        <p class="now-role">{current.data.role}</p>
      </div>
      <div class="now-group">
        <p class="tile-label">Focus</p>
        <ul class="chips" role="list">
          {focusAreas(current).map((area) => (
            <li>{area}</li>
          ))}
        </ul>
      </div>
      {outcomes.length > 0 && (
        <ul class="now-outcomes">
          {outcomes.map((text) => (
            <li class:list={{ placeholder: isPlaceholder(text) }}>
              {text.replace(/^TODO:\s*/, "")}
            </li>
          ))}
        </ul>
      )}
    </section>

    {games.map((project) => (
      <GameTile
        project={project}
        class={`game-${project.data.homeSlot}`}
        wide={project.data.homeSlot === 3 || project.data.homeSlot === 4}
      />
    ))}

    <section
      class="tile experience"
      id="experience"
      aria-labelledby="exp-title"
    >
      <h2 id="exp-title">Experience</h2>
      <ol class="jobs" role="list">
        {jobs.map((job) => (
          <li>
            <span class="job-org">{job.data.org}</span>
            <span class="job-years">{yearRange(job)}</span>
            <span class="job-role">{job.data.role}</span>
          </li>
        ))}
      </ol>
      <a class="more-link" href="/cv/">
        Full history and highlights
      </a>
    </section>

    <section class="tile education" aria-labelledby="edu-title">
      <h2 class="tile-label" id="edu-title">
        Education
      </h2>
      <p class="edu-school">{education.school}</p>
      <ul class="edu-degrees" role="list">
        {education.degrees.map((degree) => (
          <li>{degree}</li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  /* g1 and g2 are 4:3 game tiles; g3 and g4 are wide 16:9 previews. */
  .home {
    grid-template-areas:
      "hero hero"
      "mail mail"
      "feat feat"
      "now now"
      "g1 g2"
      "g3 g3"
      "g4 g4"
      "exp exp"
      "edu edu";
  }

  /* Wide screens pair cards of about the same height, alternating sides:
     the name and contact cards beside the featured game, the Now card beside
     two tiles over a wide preview, and Education over a wide preview beside
     Experience. */
  @media (min-width: 56rem) {
    .home {
      grid-template-areas:
        "hero hero feat feat"
        "mail mail feat feat"
        "now now g1 g2"
        "now now g3 g3"
        "edu edu exp exp"
        "g4 g4 exp exp";
    }

    /* The games' shapes set their rows' minimum height. Where the card
       beside them is a little taller, they stretch to fill the gap instead
       of leaving one. The fixed width stops a stretched tile from widening
       to keep its shape and spilling out of its columns. */
    .home :global(.game) {
      align-self: stretch;
      width: 100%;
    }
  }

  /* Hero */

  .hero {
    grid-area: hero;
    container-type: inline-size;
    gap: 22px;
  }

  /* The photo and the name share the top line. The name is sized to the
     card's width (the card is its container), so it fits on that line at
     every screen size. */
  .hero-id {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 22px);
  }

  .hero :global(.hero-photo) {
    flex: none;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
  }

  @media (max-width: 30rem) {
    .hero :global(.hero-photo) {
      width: 64px;
      height: 64px;
    }
  }

  @media (max-width: 22rem) {
    .hero :global(.hero-photo) {
      width: 52px;
      height: 52px;
    }
  }

  .hero h1 {
    font-size: clamp(1.75rem, 11.5cqi, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  /* One sentence per line. The size follows the card's width so the first
     sentence fits on its line at every desktop width; phones still wrap. */
  .hero-lede {
    color: var(--muted);
    font-size: clamp(1rem, 4.2cqi, var(--step-1));
    line-height: 1.45;
  }

  .hero-lede span {
    display: block;
  }

  /* Featured game */

  .feature {
    grid-area: feat;
    min-height: 23rem;
  }

  /* The same slow zoom as the game tiles (see GameTile.astro). */
  .feature :global(img) {
    transition: transform 0.4s ease;
  }

  .feature:hover :global(img) {
    transform: scale(1.03);
  }

  .feature-card {
    position: absolute;
    inset: auto 12px 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    padding: 14px 16px;
    border-radius: var(--radius-inner);
    background: var(--pill);
    color: var(--on-pill);
  }

  .feature-card h2 {
    font-size: var(--step-2);
  }

  .feature-tagline {
    color: #5b636d;
    font-size: var(--step--1);
  }

  .feature-card .button--primary {
    background: #14171b;
    color: #ffffff;
  }

  .feature-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  @media (max-width: 55.99rem) {
    .feature {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }
  }

  /* Now: the current job. Half the grid on wide screens, with the games
     beside it; the full width below that. */

  .now {
    grid-area: now;
    gap: 22px;
  }

  .now h2 {
    font-size: var(--step-3);
  }

  .now-group {
    display: grid;
    gap: 8px;
  }

  .now-role {
    color: var(--on-strong-muted);
  }

  .now-outcomes {
    display: grid;
    gap: 8px;
    padding-left: 1.1em;
  }

  /* Games */

  .home :global(.game-1) {
    grid-area: g1;
  }

  .home :global(.game-2) {
    grid-area: g2;
  }

  .home :global(.game-3) {
    grid-area: g3;
  }

  .home :global(.game-4) {
    grid-area: g4;
  }

  /* Experience */

  .experience {
    grid-area: exp;
  }

  .jobs {
    display: grid;
  }

  .jobs li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0 12px;
    padding-block: 10px;
    border-top: 1px solid var(--line);
  }

  .job-org {
    font-weight: 650;
  }

  .job-years {
    color: var(--muted);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .job-role {
    grid-column: 1 / -1;
    color: var(--muted);
    font-size: var(--step--1);
  }

  /* Contact and education */

  .contact {
    grid-area: mail;
    justify-content: space-between;
  }

  .contact-email {
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .education {
    grid-area: edu;
  }

  .edu-school {
    font-size: var(--step-1);
    font-weight: 700;
  }

  .edu-degrees {
    color: var(--muted);
  }
</style>
