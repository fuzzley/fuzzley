---
import Mark from "./Mark.astro";

const path = Astro.url.pathname;

const items = [
  { href: "/projects/", label: "Projects" },
  { href: "/cv/", label: "CV" },
  { href: "/#contact", label: "Contact" },
];

// "page" for the page itself, "true" for a page inside its section.
function current(href: string) {
  if (href.includes("#")) return undefined;
  if (path === href || path === href.slice(0, -1)) return "page";
  return path.startsWith(href) ? "true" : undefined;
}
---

<header class="site-header page">
  <a class="brand" href="/">
    <Mark size={26} />
    <span>fuzzley</span>
  </a>
  <nav class="site-nav" aria-label="Main">
    <ul role="list">
      {items.map((item) => (
        <li>
          <a href={item.href} aria-current={current(item.href)}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
