---
// A game's screenshot on its own color, with its name linking to the project
// page and a button straight into the game.
import { Picture } from "astro:assets";
import GitHubLink from "./GitHubLink.astro";
import {
  coverTransition,
  playPath,
  playShort,
  projectPath,
  type Project,
} from "../lib/projects";

interface Props {
  project: Project;
  headingLevel?: 2 | 3;
  class?: string;
  /** A large 16:9 preview spanning two grid columns, instead of a 4:3 tile. */
  wide?: boolean;
  /** The image's displayed width, for picking a source size. */
  sizes?: string;
}

const {
  project,
  headingLevel = 2,
  class: className,
  wide = false,
  sizes = wide
    ? "(min-width: 56rem) 37rem, calc(100vw - 32px)"
    : "(min-width: 56rem) 18rem, 50vw",
} = Astro.props;
const Heading = headingLevel === 3 ? "h3" : "h2";
const widths = wide ? [480, 720, 960, 1280] : [320, 480, 640];
---

<article
  class:list={["tile tile--media game", { "game--wide": wide }, className]}
  style={`--tint: ${project.data.tint}`}
>
  <Picture
    src={project.data.cover}
    alt=""
    pictureAttributes={{ class: "tile-media" }}
    widths={widths}
    sizes={sizes}
    formats={["avif"]}
    fallbackFormat="webp"
    style={coverTransition(project)}
  />
  <div class="game-bar">
    <Heading class="pill game-title">
      <a class="stretched" href={projectPath(project)}>
        {project.data.title}
      </a>
    </Heading>
    <div class="game-actions above">
      <a
        class="pill pill--dark"
        href={playPath(project)}
        aria-label={`${playShort(project)} ${project.data.title}`}
      >
        {playShort(project)}
      </a>
      <GitHubLink
        href={project.data.repo}
        projectTitle={project.data.title}
        variant="overlay"
      />
    </div>
  </div>
</article>

<style>
  .game {
    aspect-ratio: 4 / 3;
    container-type: inline-size;
  }

  .game--wide {
    aspect-ratio: 16 / 9;
  }

  /* Too narrow for the name and both buttons: drop Play and keep the name,
     which leads to the project page and its full-size play button. */
  @container (max-width: 14rem) {
    .game-actions .pill--dark {
      display: none;
    }
  }

  .game-bar {
    position: absolute;
    inset: auto 10px 10px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 6px;
  }

  .game-title {
    font-size: var(--step--1);
    letter-spacing: 0;
  }

  /* Play and GitHub, kept on the right even when a long title pushes them
     to a new line. */
  .game-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  .game :global(img) {
    transition: transform 0.4s ease;
  }

  .game:hover :global(img) {
    transform: scale(1.03);
  }
</style>
