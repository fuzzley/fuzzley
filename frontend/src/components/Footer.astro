---
import { profile, sourceRepo } from "../data/profile";

const build = __BUILD_INFO__;
const builtAt = new Date(build.buildTime);
const builtOn = builtAt.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<footer class="site-footer page">
  <p>
    © {builtAt.getUTCFullYear()} {profile.name}
  </p>
  {build.commit === "dev" ? (
    <p>Built on {builtOn}</p>
  ) : (
    <p>
      Built from{" "}
      <a href={`${sourceRepo}/commit/${build.commit}`}>{build.commit}</a> on{" "}
      {builtOn}
    </p>
  )}
</footer>
