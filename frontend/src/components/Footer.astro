---
import { profile, sourceRepo } from "../data/profile";
import { linkName, newTab } from "../lib/links";

const build = __BUILD_INFO__;
const commitUrl = `${sourceRepo}/commit/${build.commit}`;
const builtAt = new Date(build.buildTime);
const builtOn = builtAt.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<footer class="site-footer page">
  <p>
    © {builtAt.getUTCFullYear()} {profile.name}
  </p>
  {build.commit === "dev" ? (
    <p>Built on {builtOn}</p>
  ) : (
    <p>
      Built from{" "}
      <a
        href={commitUrl}
        {...newTab(commitUrl)}
        aria-label={linkName(build.commit, commitUrl)}
      >
        {build.commit}
      </a>{" "}
      on {builtOn}
    </p>
  )}
</footer>
