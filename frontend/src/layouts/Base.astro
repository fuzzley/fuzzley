---
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  /** The whole <title>, also used for link previews. */
  title: string;
  description: string;
  /** Link preview image: a root-relative path or an absolute URL. */
  image?: string;
  /** schema.org data for search engines. */
  jsonLd?: Record<string, unknown>;
  ogType?: "website" | "profile";
  /** For pages that shouldn't be indexed, such as the 404 page. */
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/images/og-home.jpg",
  jsonLd,
  ogType = "website",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const build = __BUILD_INFO__;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <meta
      name="build-version"
      content={`${build.commit} (${build.buildTime})`}
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Andrey Gavel" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta
      name="theme-color"
      content="#e9ecef"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0f1113"
      media="(prefers-color-scheme: dark)"
    />
    <script is:inline>
      // Applies a theme chosen with the toggle (components/ThemeToggle.astro)
      // before the first paint, so the page never flashes the other one, and
      // tints the browser's toolbar to match.
      (function () {
        let theme = null;
        try {
          theme = localStorage.getItem("theme");
        } catch {
          // Storage is blocked: follow the system theme.
        }
        if (theme !== "light" && theme !== "dark") return;
        document.documentElement.dataset.theme = theme;
        const color = theme === "dark" ? "#0f1113" : "#e9ecef";
        document
          .querySelectorAll('meta[name="theme-color"]')
          .forEach((meta) => meta.setAttribute("content", color));
      })();
    </script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {jsonLd && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd)}
      />
    )}

    <!-- Runtime config, then the shared analytics bootstrap. Order matters:
         analytics.js reads the measurement ID out of window.__ENV. -->
    <script is:inline src="/env.js"></script>
    <script is:inline src="/analytics.js"></script>
    <script is:inline>
      // Counts plays, which Google Analytics doesn't see on its own because
      // the games are on the same site: a click on any link into
      // /projects/<slug>/play/ sends a play_game event naming the game.
      document.addEventListener("click", function (event) {
        const link = event.target.closest && event.target.closest("a[href]");
        if (!link || typeof window.gtag !== "function") return;
        const match = link
          .getAttribute("href")
          .match(/\/projects\/([^/]+)\/play\//);
        if (match) window.gtag("event", "play_game", { game: match[1] });
      });
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" class="page">
      <slot />
    </main>
    <Footer />
  </body>
</html>
