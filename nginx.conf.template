server {
    listen ${PORT};
    server_name localhost;

    # Ensure redirects (such as adding a trailing slash to directories like /project/solitaire)
    # are relative so that the internal container port (e.g. :8080) and HTTP scheme are not leaked
    # when running behind a TLS-terminating reverse proxy (Cloud Run).
    absolute_redirect off;
    port_in_redirect off;

    # The nginx image ships with compression off. HTML is always included once
    # it is on; these are the other text types the site serves.
    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

    # The site's build fingerprints every file in /_astro/, and each game's
    # build does the same in its own assets/ folder, so these files never
    # change in place and browsers can keep them for a year.
    location /_astro/ {
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~ ^/projects/[^/]+/play/assets/ {
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # The games moved from /project/<slug>/ to /projects/<slug>/play/. A
    # permanent redirect keeps old links and search results working, and the
    # browser carries any #hash across.
    location ^~ /project/ {
        rewrite ^/project/([^/]+)/?(.*)$ /projects/$1/play/$2 permanent;
    }

    # Runtime config is regenerated per-deploy; never cache it.
    location = /env.js {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-store";
    }

    # Version info should never be cached.
    location = /version.json {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-store";
    }

    # Every page is a real file, so anything else is a 404 rather than the
    # home page served with a 200.
    #
    # Browsers must check back before reusing anything served from here: a
    # stale page would ask for /_astro/ or play/assets/ files that the next
    # deploy no longer has. An unchanged file costs only a 304.
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    error_page 404 /404.html;
    location = /404.html {
        root /usr/share/nginx/html;
        internal;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
