# fuzzley.info is the site's one address. Cloud Run also maps andreygavel.com,
# andrey-gavel.com, fuzzley.net and fuzzley.org to this service, and serves it
# at its own run.app address, so every other host is sent to the same path on
# fuzzley.info. Search engines then index one copy of each page, and Google
# Analytics sees one hostname. localhost and 127.0.0.1 are left alone, so the
# image can still be run and checked locally.
map $host $other_host {
    default      1;
    fuzzley.info 0;
    localhost    0;
    127.0.0.1    0;
}

server {
    listen ${PORT};
    server_name localhost;

    # A permanent redirect that keeps the path and query. It comes before any
    # location is chosen, so it also runs ahead of the redirects below.
    if ($other_host) {
        return 301 https://fuzzley.info$request_uri;
    }

    # A folder's index.html has the folder's address, so search engines and
    # analytics see one URL for each page: /cv/index.html is sent to /cv/
    # with its query, and the browser keeps any #hash. It matches the address
    # as sent: `index` rewrites $uri to …/index.html internally, so matching
    # $uri would loop.
    if ($request_uri ~ "^(?<folder>[^?]*/)index\.html(?:\?|$)") {
        return 301 $folder$is_args$args;
    }

    # Ensure redirects (such as adding a trailing slash to directories like /projects/pong/play)
    # are relative so that the internal container port (e.g. :8080) and HTTP scheme are not leaked
    # when running behind a TLS-terminating reverse proxy (Cloud Run).
    absolute_redirect off;
    port_in_redirect off;

    # The nginx image ships with compression off. HTML is always included once
    # it is on; these are the other text types the site serves.
    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

    # The site's build fingerprints every file in /_astro/, and each game's
    # build does the same in its own assets/ folder, so these files never
    # change in place and browsers can keep them for a year.
    location /_astro/ {
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~ ^/projects/[^/]+/play/assets/ {
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # The games moved from /project/<slug>/ to /projects/<slug>/play/. A
    # permanent redirect keeps old links and search results working, and the
    # browser carries any #hash across. Only a game still served here is
    # redirected: one played on another site, such as the Solitaire Collection
    # and Minesweeper on fuzzley.games, is linked there directly, and both its
    # old addresses here answer 404.
    location ~ ^/project/(?<game>[^/]*) {
        root /usr/share/nginx/html;
        if (!-d $document_root/projects/$game/play) {
            return 404;
        }
        rewrite ^/project/([^/]+)/?(.*)$ /projects/$1/play/$2 permanent;
    }

    # Runtime config is regenerated per-deploy; never cache it.
    location = /env.js {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-store";
    }

    # Version info should never be cached.
    location = /version.json {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-store";
    }

    # Every page is a real file, so anything else is a 404 rather than the
    # home page served with a 200.
    #
    # Browsers must check back before reusing anything served from here: a
    # stale page would ask for /_astro/ or play/assets/ files that the next
    # deploy no longer has. An unchanged file costs only a 304.
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    error_page 404 /404.html;
    location = /404.html {
        root /usr/share/nginx/html;
        internal;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
